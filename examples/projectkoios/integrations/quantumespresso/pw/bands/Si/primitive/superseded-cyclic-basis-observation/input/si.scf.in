&CONTROL
 calculation = 'scf'
 prefix = 'si'
 outdir = './tmp'
 pseudo_dir = './pseudo'
 verbosity = 'high'
/
&SYSTEM
 ibrav = 0
 nat = 2
 ntyp = 1
 nbnd = 12
 ecutwfc = 25.0
 occupations = 'fixed'
/
&ELECTRONS
 conv_thr = 1.0d-10
 diagonalization = 'david'
/
ATOMIC_SPECIES
Si 28.0855 Si.pbe-n-van.UPF
ATOMIC_POSITIONS crystal
Si 0.0 0.0 0.0
Si 0.25 0.25 0.25
K_POINTS automatic
6 6 6 0 0 0
CELL_PARAMETERS angstrom
2.715 0.000 2.715
2.715 2.715 0.000
0.000 2.715 2.715
