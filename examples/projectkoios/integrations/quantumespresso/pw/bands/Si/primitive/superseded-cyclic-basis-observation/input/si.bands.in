&CONTROL
 calculation = 'bands'
 prefix = 'si'
 outdir = './tmp'
 pseudo_dir = './pseudo'
 verbosity = 'high'
/
&SYSTEM
 ibrav = 0
 nat = 2
 ntyp = 1
 nbnd = 12
 ecutwfc = 25.0
 occupations = 'fixed'
 nosym = .true.
 noinv = .true.
/
&ELECTRONS
 conv_thr = 1.0d-10
 diagonalization = 'david'
 diago_full_acc = .true.
/
ATOMIC_SPECIES
Si 28.0855 Si.pbe-n-van.UPF
ATOMIC_POSITIONS crystal
Si 0.0 0.0 0.0
Si 0.25 0.25 0.25
K_POINTS crystal_b
6
0.500000 0.500000 0.500000 20
0.000000 0.000000 0.000000 20
0.000000 0.500000 0.500000 20
0.250000 0.625000 0.625000 1
0.375000 0.750000 0.375000 20
0.000000 0.000000 0.000000 1
CELL_PARAMETERS angstrom
2.715 0.000 2.715
2.715 2.715 0.000
0.000 2.715 2.715
